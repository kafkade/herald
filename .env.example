# Herald — Environment Variables
# Copy this file to .env and customize as needed.

# Bearer token for admin API authentication.
# Generate a strong token: openssl rand -hex 32
HERALD_ADMIN_TOKEN=changeme

# Server listen port.
HERALD_PORT=3000

# SQLite database file path.
HERALD_DB_PATH=/data/herald.db

# Directory containing built web assets (index.html, WASM, etc.).
# Set to empty to disable web UI serving.
HERALD_WEB_DIR=/home/herald/static

# Log level: trace, debug, info, warn, error
HERALD_LOG_LEVEL=info

# Log output format: json (for production) or pretty (default, human-readable)
# HERALD_LOG_FORMAT=pretty
